  <title>Save the Date | Myllena & Thales</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #fcfbf9;
      color: #333333;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px 15px;
      text-align: center;
    }
    .card {
      max-width: 420px;
      width: 100%;
      background: #ffffff;
      padding: 30px 20px;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
      border: 1px solid #eaeaea;
    }
    .photo-container {
      width: 100%;
      height: 260px;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 25px;
      background-color: #f0eee9;
    }
    .photo-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .subtitle {
      font-size: 0.85rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #888888;
      margin-bottom: 8px;
    }
    h1 {
      font-family: 'Georgia', serif;
      font-size: 2rem;
      font-weight: normal;
      margin-bottom: 15px;
      color: #2c2c2c;
    }
    .date {
      font-size: 1.25rem;
      font-weight: 600;
      color: #444444;
      margin-bottom: 20px;
    }
    .description {
      font-size: 0.95rem;
      color: #666666;
      line-height: 1.5;
      margin-bottom: 25px;
    }
    #countdown {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 25px;
    }
    .time-box {
      background: #f8f7f4;
      padding: 12px 8px;
      border-radius: 10px;
      flex: 1;
      max-width: 75px;
      border: 1px solid #eceae4;
    }
    .time-box span {
      display: block;
      font-size: 1.3rem;
      font-weight: 700;
      color: #2c2c2c;
    }
    .time-box label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #888888;
    }
    .footer-note {
      font-size: 0.9rem;
      font-style: italic;
      color: #777777;
    }
  </style>
</head>
